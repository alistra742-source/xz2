# Postgres (Railway/Render style). Falls back to a local sqlite file when empty.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
SECRET_KEY=change-me-to-a-long-random-string
PORT=8080
ADMIN_CODE=Tagys322@

# Bot engine
BROWSERS=4
PAGES_PER_BROWSER=3
# pages allowed to work the SAME order at once
PARALLEL_HEARTS=4
PARALLEL_FAVORITES=2
PARALLEL_SHARES=2
PARALLEL_VIEWS=1
# zefame waits after clicking Get Now
ZEFAME_TIMER_WAIT=105
ZEFAME_FINAL_WAIT=20
WORKER_ENABLED=true
MONITOR_ENABLED=true
USE_TOR=false
PROXY_URL=

